<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Deliberately NO android.permission.INTERNET: CapITV cannot talk to the network. -->

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Package visibility (Android 11+): only the apps CapITV may launch. -->
    <queries>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="org.smarttube.stable" />
        <package android:name="org.smarttube.beta" />
        <package android:name="com.liskovsoft.smarttubetv.beta" />
        <package android:name="com.teamsmart.videomanager.tv" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.canal.android.canal" />
        <package android:name="com.android.tv.settings" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CapITV">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.ekrtf.capitv.SHOW_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Google TV has no "default launcher" setting: the stock launcher wins HOME by
            priority. This service only watches for the HOME key and brings CapITV to the
            front. It never reads screen content. Enabled by provision/capitv-provision.sh.
        -->
        <service
            android:name=".HomeKeyService"
            android:exported="false"
            android:label="@string/home_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>
    </application>
</manifest>
