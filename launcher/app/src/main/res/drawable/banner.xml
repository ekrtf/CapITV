<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180dp TV banner: dark tile with a red accent bar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#FF0E0F13" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFE50914" />
        </shape>
    </item>
</layer-list>
